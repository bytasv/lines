{
  "name": "@lines/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "migrate": "tsx scripts/migrate-user.ts",
    "pair": "tsx scripts/pair-device.ts",
    "gen:codex-protocol": "codex app-server generate-ts --out ../shared/codexProtocol && node scripts/normalize-codex-protocol.mjs ../shared/codexProtocol"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.211",
    "@clerk/backend": "^3.12.0",
    "@lines/shared": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.154.0",
    "dotenv": "^17.4.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
