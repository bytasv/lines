# Production .env template — copy to /home/lines/app/.env and `chmod 600` it.
#
# This lives at deploy/env.production.example rather than /.env.production.example
# because .gitignore's `.env.*` rule negates only `.env.example`: a root
# `.env.production.example` would be silently untracked.
#
# The bridge (server/src/index.ts) and the storage server (storage/src/index.ts)
# both dotenv-load this exact file; vite reads it at build time (envDir: '..').
# The worker does NOT — its two variables are passed via systemd `Environment=`.
#
# Do not point systemd's `EnvironmentFile=` at this file: systemd's parser
# treats `#` after whitespace as a comment and performs no shell expansion, so a
# Postgres password containing `#`, `$` or a space is silently mangled.

# --- Clerk (PRODUCTION instance: pk_live/sk_live, not the dev pk_test/sk_test) ---
# Baked into the web bundle at build time (web/src/lib/clerk.ts) — changing it
# requires a rebuild, not a restart. Storage reuses it as its clerkMiddleware
# publishable key, so this one entry covers both.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# BRIDGE_AUTH_DISABLED must stay UNSET. Set (or with CLERK_SECRET_KEY empty) the
# bridge binds every socket to user "local" and is an unauthenticated remote
# shell on this box. `journalctl -u lines-bridge | grep '\[auth\]'` must be empty.

# --- Where the browser finds the bridge (web/src/ws.ts) ---
# Build-time only, baked into web/dist. MUST be wss:// on an HTTPS page and MUST
# NOT end in a slash — ws.ts appends "/?token=<jwt>" itself.
# Unset, ws.ts falls back to fetch('/__bridge'), a vite-dev-only middleware that
# does not exist in a static build: the SPA fallback returns index.html, JSON
# parsing throws, and the UI reconnects forever.
VITE_BRIDGE_WS_URL=wss://lines.example.com/bridge

# --- Supabase ---
# Pooled (pgbouncer, :6543) for the app; direct (:5432) for `prisma migrate`.
# Both must address the SAME project — a mismatched <ref> host segment is the
# usual cause of P2021 "table does not exist" against an apparently healthy DB.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# --- Storage server ---
# PORT belongs to the storage server alone. STORAGE_URL is how the bridge
# reaches it — localhost only; the browser never calls storage directly.
PORT=8790
STORAGE_URL=http://127.0.0.1:8790

# --- Local ports ---
# Pinned deliberately: ephemeral ports are a dev affordance, and nginx needs a
# fixed proxy_pass target. A second checkout on this box needs a different
# LINES_INSTANCE *and* different ports, or the two fight over 8787 and
# cross-contaminate ~/.lines-app/run/.
LINES_BRIDGE_PORT=8787
LINES_WORKER_PORT=8788
# Kept here for reference only. LINES_INSTANCE must ALSO be set via Environment=
# in both lines-worker.service and lines-bridge.service: ESM hoisting evaluates
# workerProtocol.ts (which derives the runtime-discovery dir from it) before the
# bridge's dotenv.config() runs, so a value set only here is ignored and the
# bridge looks for the worker in ~/.lines-app/run/default/ instead of run/prod/.
LINES_INSTANCE=prod

# --- Relay: not used in this topology. Leave RELAY_URL unset. ---
# RELAY_AUTH_DISABLED must never be set anywhere near a deployment.

# --- Cloudflare R2 (recipe images) ---
# Optional: recipes save without images; unset, the upload route answers 503.
# The bucket must be public-read and R2_PUBLIC_BASE_URL must be the public base
# (pub-xxxx.r2.dev or a custom domain), NOT the S3 API endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
