# Copy to deploy/docker/lines.env, fill in, `chmod 600`. Never commit it.
#
# This file is used twice, which is why it holds both secrets and build inputs:
#   - as compose's --env-file, so ${LINES_DOMAIN} and the VITE_* build args
#     interpolate into compose.yml
#   - as `env_file:` for the relay and storage containers
#
# Values consumed only by the browser bundle (VITE_*) are baked in at image
# build time. Changing one means `docker compose build web && up -d web`, not a
# restart.

# --- Routing ---
# Bare hostname, no scheme and no path: it goes straight into a Traefik
# Host(`...`) rule.
#
# The names that come off this one value, and the split between them is a
# security boundary rather than tidiness:
#   run.<domain>  the web bundle. Nothing else answers here.
#   app.<domain>  the same bundle, only until released desktop builds move to
#                 run.<domain>; then a redirect.
#   <domain>      the relay's /agent and /client, plus the static, keyless
#                 marketing page (www redirects here).
#   api.<domain>  storage.
# DNS needs an A record for run.<domain>, and Clerk's allowed origins and
# redirect URLs have to name it — the sign-in flow is served from there.
LINES_DOMAIN=example.com

# --- Auto-deploy (CI-built images) ---
# Prefix prepended to every image name below, must end in a slash. Leave unset
# to build from source locally exactly as before. The deploy pipeline's
# forced-command SSH script sets this on the VPS so `pull`/`up` use images
# GitHub Actions already built and pushed, instead of building on the box.
REGISTRY=

# --- Browser bundle (build-time only) ---
# Points at the RELAY's /client endpoint, not at a bridge: the bridge runs on
# the user's own machine and dials out to /agent. No trailing slash — the relay
# matches its endpoint path exactly.
VITE_BRIDGE_WS_URL=wss://example.com/client
# Public storage origin. Setting this turns on the device-pairing gate: the web
# app lists the user's machines before it opens a socket, because the relay
# refuses a connection that names no device.
VITE_STORAGE_URL=https://api.example.com
# pk_live for a production Clerk instance, pk_test for a development one.
# Storage reuses this as its clerkMiddleware publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
# Direct link to the published macOS DMG (public R2 bucket). Unset, the web app
# shows no download surface and the pairing screens assume the desktop app is
# already installed. Use the stable alias key — `${R2_RELEASE_PUBLIC_BASE_URL}/desktop/Lines-latest.dmg`
# — which every release republishes, so this is set once rather than per release.
VITE_DESKTOP_DOWNLOAD_URL=
# Origin of the app host, no trailing slash. Read only by the marketing page on
# the apex (the `landing` image): every call to action links to <this>/sign-in.
VITE_APP_URL=https://run.example.com

# --- Clerk (server-side) ---
# Verified by BOTH the relay (browser tokens on /client) and storage. A pk_test
# with an sk_live shows up only as a 1008 close on every socket.
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# RELAY_AUTH_DISABLED must stay UNSET. Set, the relay accepts any device secret
# and binds every client to one user.

# --- Relay -> storage shared secret ---
# /v1/devices/verify has no user token to check: it is called machine to machine
# and answers with the user id owning a device secret. /v1/devices/presence is the
# same channel, carrying whether a machine's bridge is attached. This is what stops
# anyone else calling either. Generate with `openssl rand -hex 32`. Storage refuses
# both (503) when it is unset, which fails pairing closed rather than open.
RELAY_SHARED_SECRET=

# --- Supabase (storage only; the relay holds no database credentials) ---
# Pooled (pgbouncer, :6543) for the app, direct (:5432) for prisma migrate.
# Both must address the same project — a mismatched <ref> host segment is the
# usual cause of P2021 against an apparently healthy database.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# --- Cloudflare R2 (recipe images, optional) ---
# Unset, recipes still save and the upload route answers 503.
# R2_PUBLIC_BASE_URL must be the public base (pub-xxxx.r2.dev or a custom
# domain), NOT the S3 API endpoint — storage warns at boot if it looks wrong.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Desktop releases (build machine only) ---
# Not read by any container: `npm run release -w desktop` runs on a Mac, from the
# repo-root .env. Listed here only so the deployment's R2 story is in one place —
# releases go to a SECOND, fully public bucket, because public-read is a
# bucket-level setting and the images bucket holds user uploads.
#   R2_RELEASE_BUCKET, R2_RELEASE_PUBLIC_BASE_URL — see .env.example
