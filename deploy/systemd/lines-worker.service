; Lines worker — install to /etc/systemd/system/lines-worker.service
;
; The only unit that needs explicit Environment=: worker.ts loads no dotenv (its
; import graph is deliberately minimal), and workerProtocol.ts reads
; LINES_WORKER_PORT / LINES_INSTANCE from process.env at import time.
;
; Restarting this unit kills every in-flight turn — that is by design and the
; whole reason the bridge/worker split exists.

[Unit]
Description=Lines worker (Claude Agent SDK queries + CLI children)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lines
Group=lines
WorkingDirectory=/home/lines/app
Environment=NODE_ENV=production
Environment=HOME=/home/lines
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LINES_WORKER_PORT=8788
Environment=LINES_INSTANCE=prod
ExecStart=/home/lines/app/node_modules/.bin/tsx /home/lines/app/server/src/worker.ts
Restart=always
RestartSec=2
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
; Each concurrent turn is a separate ~262 MB claude native binary (300-600 MB
; RSS). Cap the worker so the OOM killer takes a Claude child, not sshd.
MemoryHigh=5G
MemoryMax=6G
TasksMax=512
LimitNOFILE=65535
SyslogIdentifier=lines-worker
NoNewPrivileges=yes
PrivateTmp=yes
; No ProtectHome / ProtectSystem here: this process runs Claude Code and must
; read and write user workspaces anywhere under /home/lines.

[Install]
WantedBy=multi-user.target
