; Install to /etc/systemd/system/lines-backup.timer, then:
;   systemctl daemon-reload && systemctl enable --now lines-backup.timer

[Unit]
Description=Nightly Lines backup

[Timer]
OnCalendar=*-*-* 03:30:00
; The backup bounces lines-bridge, so jitter keeps it off the exact minute a
; human is likely to be watching, and Persistent catches a missed run.
RandomizedDelaySec=600
Persistent=true
Unit=lines-backup.service

[Install]
WantedBy=timers.target
