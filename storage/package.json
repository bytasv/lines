{
  "name": "@lines/storage-server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytasv/lines.git",
    "directory": "storage"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../.env -- prisma studio",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@lines/shared": "*",
    "@aws-sdk/client-s3": "^3.744.0",
    "@clerk/express": "^1.7.41",
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
