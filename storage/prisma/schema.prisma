// Storage-only schema: per-user workflows, settings, and session metadata.
// Access is always through the app (Prisma queries filtered by the verified
// Clerk userId); RLS is a hardening follow-up.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled (pgbouncer) URL for the app
  directUrl = env("DIRECT_URL") // Supabase direct URL for prisma migrate
}

generator client {
  provider = "prisma-client-js"
}

model Workflow {
  userId    String   @map("user_id")
  id        String
  data      Json // WorkflowDef (wire shape = DB shape)
  // Mirror of data.published, promoted to a column so the cross-user "shared"
  // query can index on it instead of filtering a JSON path.
  published Boolean  @default(false)
  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, id])
  @@index([published])
  @@index([userId, updatedAt(sort: Desc)]) // delta pulls: `?since=`
  @@map("workflows")
}

// One immutable row per (owner, step, version). The head (max version) is the
// author's editable step; older versions stay so workflows pinned to them keep
// resolving the exact content — a republish can never rewrite history.
model StepVersion {
  userId    String   @map("user_id")
  id        String
  version   Int
  data      Json // StepDef
  published Boolean  @default(false)
  updatedAt DateTime @default(now()) @map("updated_at")
  // This row's own insert time. A *lineage's* creation is `min(created_at)` over
  // (user_id, id) — every version of one step shares one birthday, and it is not
  // this per-row value (see GET /steps).
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, id, version])
  // Both reads are `DISTINCT ON (user_id, id) … ORDER BY user_id, id, version DESC`,
  // so the trailing column has to be descending — the ascending primary key can't
  // serve that ordering and would force a sort over every version row.
  @@index([userId, id, version(sort: Desc)])
  @@index([published, userId, id, version(sort: Desc)])
  @@map("step_versions")
}

// One immutable row per (owner, recipe, version), exactly as StepVersion: the
// head (max version) is the author's editable recipe and older versions stay so
// a version history can never be rewritten by a republish.
model RecipeVersion {
  userId    String   @map("user_id")
  id        String
  version   Int
  data      Json // RecipeDef — including `tags` and, for a bundle, `members`
  published Boolean  @default(false)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([userId, id, version])
  // Both head reads are `DISTINCT ON (user_id, id) … ORDER BY user_id, id, version DESC`,
  // so the trailing column has to be descending (see StepVersion).
  @@index([userId, id, version(sort: Desc)])
  @@index([published, userId, id, version(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)]) // delta pulls: `?since=`
  @@map("recipe_versions")
}

// Public run counter, keyed by recipe *identity* rather than version — it has to
// survive version churn, be incrementable in one atomic statement, and stay
// unreachable from `PUT /recipes`, whose last-write-wins blob would otherwise
// let a stale author push clobber it. Never mirrored into `data`.
model RecipeStats {
  userId    String    @map("user_id") // recipe OWNER (identity), not the runner
  id        String
  runCount  Int       @default(0) @map("run_count")
  lastRunAt DateTime? @map("last_run_at")

  @@id([userId, id])
  @@map("recipe_stats")
}

model UserSettings {
  userId    String   @id @map("user_id")
  data      Json // per-user UI settings blob
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("user_settings")
}

// Auto-mode guard allowlist, one blob per user (tens of entries — the
// row-per-item egress argument that shaped AgentMemoryFile does not apply).
// Never applied silently on the receiving bridge: a divergence is reviewed.
model GuardAllowlist {
  userId    String   @id @map("user_id")
  data      Json // GuardAllowlistBlob
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("guard_allowlist")
}

// User-managed MCP servers, one blob per user — same shape and same
// never-applied-silently contract as GuardAllowlist.
//
// Header VALUES are never here: the blob carries header names only, and the
// values stay in a local-only file on each bridge (see server/src/store.ts).
model McpConnections {
  userId    String   @id @map("user_id")
  data      Json // McpConnectionsBlob
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("mcp_connections")
}

model Session {
  userId String @map("user_id")
  id     String @db.Uuid
  data   Json // SessionMeta (metadata only; transcripts stay host-local)

  /// Soft delete, and it has to be one: a hard delete leaves peers nothing to
  /// adopt, so whichever machine still held the row pushed it straight back on its
  /// next sync — the undeletable session. Deleting also bumps `updatedAt`, so the
  /// tombstone lands inside every peer's next delta window.
  deletedAt DateTime? @map("deleted_at")

  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([userId, id])
  @@index([userId, updatedAt(sort: Desc)]) // delta pulls + the newest-500 bound
  @@map("sessions")
}

// cwd -> project key, one blob per user. Absolute paths are machine-local, so
// this is what lets a second install recognise a session's checkout as the same
// repo it has at a different path.
model ProjectKeys {
  userId    String   @id @map("user_id")
  data      Json // Record<cwd, projectKey>
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("project_keys")
}

// Superseded by AgentMemoryFile. Kept (unread) for one release so a rollback
// still has its data; drop once the row-per-file table has proven itself.
model AgentMemory {
  userId    String   @id @map("user_id")
  data      Json // MemoryFileMap
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("agent_memory")
}

// Cross-machine agent memory (allowlisted ~/.claude locations only). The SDK
// still reads the disk copy — this is the shared source of truth, merged
// per-file last-write-wins server-side.
//
// One row per file rather than one blob per user: as a blob, every push had to
// read the whole map, merge in JS, write it back and echo it, so a one-line
// memory edit moved the entire map three times.
model AgentMemoryFile {
  userId    String   @map("user_id")
  key       String
  /**
   * Empty for a tombstone; `deleted` is the flag that matters.
   */
  content   String
  deleted   Boolean  @default(false)
  updatedAt DateTime @map("updated_at")

  @@id([userId, key])
  @@index([userId, updatedAt(sort: Desc)]) // delta pulls
  @@map("agent_memory_files")
}

/// A machine paired to a user, so a hosted browser can reach that machine's bridge.
///
/// Only the *hash* of the pairing secret is stored: the plaintext is generated on
/// the machine and never leaves it, so this row cannot be replayed to impersonate
/// a device. See storage/src/schema.credentials.test.ts, which allowlists exactly
/// this one field.
model Device {
  id String @id

  /// Null until a signed-in user claims the pairing code, which is what binds a
  /// machine to an account. The relay refuses an unclaimed device.
  userId String? @map("user_id")

  name     String
  platform String?

  /// sha256 of the secret the machine presents on /agent.
  secretHash String @map("secret_hash")

  /// One-time code the user types on the web to claim this device. Cleared once
  /// claimed, so it cannot be replayed.
  pairingCode      String?   @unique @map("pairing_code")
  /// Unclaimed devices expire; a stale code must not stay claimable forever.
  pairingExpiresAt DateTime? @map("pairing_expires_at")

  /// Browser<->bridge contract this machine speaks, so the web app can load a
  /// build that matches it.
  appProtocol Int? @map("app_protocol")

  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  /// Whether a bridge is attached to this machine's hub, as last reported by the
  /// relay on attach/detach (`POST /v1/devices/presence`). Storage cannot observe
  /// this itself — only the relay holds hub liveness.
  ///
  /// Never read on its own: the relay is the only writer, so a relay crash would
  /// leave this stuck true forever. It is believed only while `lastSeenAt` is
  /// fresh — see presenceOf() in src/presence.ts.
  online     Boolean   @default(false)
  /// Revocation is a tombstone, not a delete: the row stays as an audit trail.
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("devices")
}

/// Machine-scope grant: a guest may see and use every session on this device,
/// subject to `caps`. The device's owner is never a row here — ownership is
/// `Device.userId` and stays the fast path that consults no share table at all.
model DeviceMember {
  deviceId String @map("device_id")
  /// The grantee.
  userId   String @map("user_id")
  /// Denormalized host user, so /v1/devices/authorize answers in one query.
  ownerId  String @map("owner_id")
  /// ShareCaps. Read through parseShareCaps(), which denies anything absent.
  caps     Json
  /// The guest grant the host's machine minted for the invite this came from
  /// (an opaque id, never the token). Lets that machine drop its grant once the
  /// share is gone from here, even if the revoke happened while it was offline.
  grantId  String? @map("grant_id")

  createdAt DateTime  @default(now()) @map("created_at")
  /// A tombstone, as Device.revokedAt: revocation must leave an audit trail.
  revokedAt DateTime? @map("revoked_at")

  @@id([deviceId, userId])
  @@index([userId])
  @@map("device_members")
}

/// Session-scope grant: exactly the listed session, on the listed machine.
model SessionShare {
  /// Which machine hosts it. Needed for relay routing — a session id alone does
  /// not say which bridge to reach.
  deviceId  String @map("device_id")
  userId    String @map("user_id")
  sessionId String @map("session_id") @db.Uuid
  ownerId   String @map("owner_id")
  caps      Json
  /// As DeviceMember.grantId.
  grantId   String? @map("grant_id")

  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@id([deviceId, userId, sessionId])
  @@index([userId])
  @@map("session_shares")
}

/// One pending invite, covering the email and the link flow alike.
model ShareInvite {
  /// URL-safe random; the link is /join/<code>.
  code     String  @id
  ownerId  String  @map("owner_id")
  deviceId String  @map("device_id")
  /// Null = machine share.
  sessionId String? @map("session_id") @db.Uuid
  /// Lowercased. Null = anyone holding the link may claim it.
  inviteeEmail String? @map("invitee_email")
  caps         Json
  /// The guest grant the host's machine minted for this invite; copied onto the
  /// grant row on claim. See DeviceMember.grantId.
  grantId      String? @map("grant_id")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  /// Single use: written in the same transaction as the grant, so a replay 409s.
  claimedBy String?   @map("claimed_by")
  claimedAt DateTime? @map("claimed_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([ownerId])
  @@index([inviteeEmail])
  @@map("share_invites")
}

/// Display identity cache, so a shared session can name who is in it without
/// every client holding a Clerk backend key. Written on invite and on claim.
model UserProfile {
  userId   String  @id @map("user_id")
  email    String?
  name     String?
  imageUrl String? @map("image_url")

  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("user_profiles")
}

/// People this account has shared with, so the share overlay can offer them
/// again. Deliberately outlives grants and invites: revoking access must not
/// make the address unretypeable. A convenience list, not an audit trail —
/// unlike grants, removal here is a hard delete.
model ShareContact {
  ownerId String @map("owner_id")
  /// Lowercased, as ShareInvite.inviteeEmail.
  email   String
  /// Set once they claim: lets the row show a name and avatar from UserProfile.
  userId  String? @map("user_id")

  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@id([ownerId, email])
  @@index([ownerId, lastUsedAt])
  @@map("share_contacts")
}
