// Storage-only schema: per-user workflows, settings, and session metadata.
// Access is always through the app (Prisma queries filtered by the verified
// Clerk userId); RLS is a hardening follow-up.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled (pgbouncer) URL for the app
  directUrl = env("DIRECT_URL") // Supabase direct URL for prisma migrate
}

generator client {
  provider = "prisma-client-js"
}

model Workflow {
  userId    String   @map("user_id")
  id        String
  data      Json // WorkflowDef (wire shape = DB shape)
  // Mirror of data.published, promoted to a column so the cross-user "shared"
  // query can index on it instead of filtering a JSON path.
  published Boolean  @default(false)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([userId, id])
  @@index([published])
  @@index([userId, updatedAt(sort: Desc)]) // delta pulls: `?since=`
  @@map("workflows")
}

// One immutable row per (owner, step, version). The head (max version) is the
// author's editable step; older versions stay so workflows pinned to them keep
// resolving the exact content — a republish can never rewrite history.
model StepVersion {
  userId    String   @map("user_id")
  id        String
  version   Int
  data      Json // StepDef
  published Boolean  @default(false)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([userId, id, version])
  // Both reads are `DISTINCT ON (user_id, id) … ORDER BY user_id, id, version DESC`,
  // so the trailing column has to be descending — the ascending primary key can't
  // serve that ordering and would force a sort over every version row.
  @@index([userId, id, version(sort: Desc)])
  @@index([published, userId, id, version(sort: Desc)])
  @@map("step_versions")
}

model UserSettings {
  userId    String   @id @map("user_id")
  data      Json // per-user UI settings blob
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("user_settings")
}

model Session {
  userId    String   @map("user_id")
  id        String   @db.Uuid
  data      Json // SessionMeta (metadata only; transcripts stay host-local)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([userId, id])
  @@index([userId, updatedAt(sort: Desc)]) // delta pulls + the newest-500 bound
  @@map("sessions")
}

// cwd -> project key, one blob per user. Absolute paths are machine-local, so
// this is what lets a second install recognise a session's checkout as the same
// repo it has at a different path.
model ProjectKeys {
  userId    String   @id @map("user_id")
  data      Json // Record<cwd, projectKey>
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("project_keys")
}

// Superseded by AgentMemoryFile. Kept (unread) for one release so a rollback
// still has its data; drop once the row-per-file table has proven itself.
model AgentMemory {
  userId    String   @id @map("user_id")
  data      Json // MemoryFileMap
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("agent_memory")
}

// Cross-machine agent memory (allowlisted ~/.claude locations only). The SDK
// still reads the disk copy — this is the shared source of truth, merged
// per-file last-write-wins server-side.
//
// One row per file rather than one blob per user: as a blob, every push had to
// read the whole map, merge in JS, write it back and echo it, so a one-line
// memory edit moved the entire map three times.
model AgentMemoryFile {
  userId String @map("user_id")
  key    String
  /** Empty for a tombstone; `deleted` is the flag that matters. */
  content   String
  deleted   Boolean  @default(false)
  updatedAt DateTime @map("updated_at")

  @@id([userId, key])
  @@index([userId, updatedAt(sort: Desc)]) // delta pulls
  @@map("agent_memory_files")
}
