{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    // main.ts imports the bridge's device module by path, and the server
    // workspace writes its imports with explicit .ts extensions. esbuild
    // resolves them; tsc needs telling. Safe with noEmit.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
