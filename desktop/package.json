{
  "name": "@lines/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Runs the Lines agent on this machine and keeps it reachable from the hosted app.",
  "author": "Lines",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --shell-only && LINES_LOCAL_MODE=1 electron dist/main.cjs",
    "package": "npm run build && electron-builder --mac --arm64",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/ship.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@lines/shared": "*",
    "@types/node": "^22.10.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "cloud.linesapp.desktop",
    "productName": "Lines",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "afterPack": "scripts/afterPack.mjs",
    "files": [
      "dist/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      },
      {
        "from": "dist/config.json",
        "to": "config.json"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "trayTemplate*.png",
          "icon.png"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.LINES_UPDATE_FEED_URL}"
      }
    ]
  }
}
